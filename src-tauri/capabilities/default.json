{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability set for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "opener:allow-open-path"
  ]
}
